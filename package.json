{
  "name": "agora",
  "version": "0.1.0",
  "private": true,
  "description": "Platform for community apps: members' agents act for them, in their language, with the member in control. Create an app by pasting one link into Muse.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "vitest run evals",
    "db:check": "sh db/check-apply.sh",
    "simulate": "tsx evals/run-simulation.ts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  }
}
