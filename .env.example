# mock = runs fully offline with recorded model outputs; live = calls Meta models
AGORA_MODE=mock
# where the demo keeps its state between restarts: a Postgres URL, or a file path, or neither (memory only)
DATABASE_URL=
AGORA_STATE_FILE=
# Photo intake in the demo: simulated (offline, default) or meta (Muse Spark vision + SAM 3.1; needs META_API_KEY)
AGORA_INTAKE=simulated
META_API_KEY=
# optional private memory provider
AGENTWITCH_URL=
# at least 16 characters each; required in live mode
FIELD_ENCRYPTION_SECRET=
REPORT_EXPORT_SECRET=
# which app to run from apps/
APP=kids-gear
# live mode: Meta API base URL (default https://api.meta.ai/v1, Responses API) and optional open-weight host for Spark Open (Baseten or Modal)
META_API_URL=
OPEN_MODEL_HOST=baseten
OPEN_MODEL_URL=
OPEN_MODEL_KEY=
