# Required: the app refuses to start without these three, and says which is missing.
# Meta Model API key (Muse Spark muse-spark-1.3 for translation, photo intake and the interviewer; SAM 3.1 for photo boxes)
META_API_KEY=
# at least 16 characters each: encrypts addresses and places; signs report exports
FIELD_ENCRYPTION_SECRET=
REPORT_EXPORT_SECRET=
# where state is kept between restarts: a Postgres URL, or a file path (development), or neither (memory only, development)
DATABASE_URL=
AGORA_STATE_FILE=
# optional: operator token (at least 16 characters) that opens /admin/apps, the list of every created app. Unset: no admin area
ADMIN_TOKEN=
# optional private memory provider
AGENTWITCH_URL=
# simulation and judge dashboard only: which app from apps/ to simulate
APP=kids-gear
# optional: Meta API base URL (default https://api.meta.ai/v1, Responses API) and open-weight host for Spark Open (Baseten or Modal)
META_API_URL=
OPEN_MODEL_HOST=baseten
OPEN_MODEL_URL=
OPEN_MODEL_KEY=
# deploy: serve under a sub-path such as /agora (set at build AND start); leave empty for a domain root or subdomain
AGORA_BASE_PATH=
